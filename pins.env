# pins.env: every pinned source commit. build.sh, runtime-check.sh and
# new-game.sh read this file; VERSIONS.md is generated from it.

# The recompilers (built into bin/ by build.sh). Head on 2026-10-14.
N64RECOMP_URL=https://github.com/N64Recomp/N64Recomp.git
N64RECOMP_COMMIT=ffb39cdad1da5de07eaaa48bd1db4a89a7986771
N64RECOMP_DATE=2026-05-27

# Defaults new-game.sh adds as submodules to each game project.
# N64ModernRuntime: head on 2026-10-14 (has #153 --game/--game-mode and
# register_game/start_game). Its own N64Recomp submodule is 81213c1,
# two commits behind N64RECOMP_COMMIT (deterministic dump order and docs).
N64MODERNRUNTIME_URL=https://github.com/N64Recomp/N64ModernRuntime.git
N64MODERNRUNTIME_COMMIT=cdf5abbd5026fef5c364c676e4667c45e42b6863
N64MODERNRUNTIME_DATE=2026-08-30
# RT64: the commit Zelda64Recomp's recomp-frontend branch (ab0fcb5,
# 2026-08-17) builds with, next to N64ModernRuntime 589bbf0 (one commit
# before ours). That branch is the closest reference shell for this runtime.
# Zelda's dev branch (b65c482) pins 23cab60, a pre-Plume side branch that
# fails to build with clang 22 under -Werror; RT64 main dropped -Werror.
RT64_URL=https://github.com/rt64/rt64.git
RT64_COMMIT=5473732a822a4423b5696e7cb18fecc425a59875
RT64_DATE=2026-08-02

# Reference shell (read only, never a submodule).
ZELDA64RECOMP_URL=https://github.com/Zelda64Recomp/Zelda64Recomp.git
ZELDA64RECOMP_REF_COMMIT=ab0fcb50b3c662829eeecc435e8d54cbc94aff5c
ZELDA64RECOMP_REF_DATE=2026-08-17

# Real-ESRGAN, standalone ncnn/Vulkan build (BSD-3-Clause), for upscaling texture-pack art (scripts/get-upscaler.sh).
# Release v0.2.5.0, 2022-04-24; sha256 recorded from the first download on 2026-10-14.
REALESRGAN_URL=https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesrgan-ncnn-vulkan-20220424-ubuntu.zip
REALESRGAN_SHA256=e5aa6eb131234b87c0c51f82b89390f5e3e642b7b70f2b9bbe95b6a285a40c96
